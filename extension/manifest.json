{
  "manifest_version": 3,
  "name": "LinkedIn Email Collector",
  "version": "1.2.2",
  "description": "Finds recruiter emails in LinkedIn posts by keyword and date, skips posts with excluded words, and saves them to your Job Outreach dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkedIn Email Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
