# Copy to .env (Docker) or .env.local (npm run dev / npm run worker) and fill in.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/job_outreach?retryWrites=true&w=majority

# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Encrypts SMTP/IMAP passwords in the database. Do not change it later or saved passwords stop working.
ENCRYPTION_KEY=change-me-too

# The only account that can create users. Created automatically on first login.
ADMIN_EMAIL=itsakash18.06@gmail.com
ADMIN_PASSWORD=choose-a-strong-password

# Public URL of the dashboard (used in docs / extension setup)
NEXT_PUBLIC_APP_URL=http://localhost:3000
